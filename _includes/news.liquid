<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news_is_scrollable = false %}
    {% if include.limit and page.announcements.scrollable and news_size > 4 %}
      {% assign news_is_scrollable = true %}
    {% endif %}
    <div
      class="table-responsive{% if news_is_scrollable %} news-scroll-window{% endif %}"
      {% if news_is_scrollable %}
        data-visible-items="4"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 18%">
              <span class="lang-en">{{ item.date | date: '%b %Y' }}</span>
              <span class="lang-zh">{{ item.date | date: '%Y.%m' }}</span>
            </th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if news_is_scrollable %}
      <script src="{{ '/assets/js/news-scroll.js' | relative_url | bust_file_cache }}" defer></script>
    {% endif %}
  {% else %}
    <p>
      <span class="lang-en">No news so far...</span>
      <span class="lang-zh">暂无动态...</span>
    </p>
  {% endif %}
</div>
