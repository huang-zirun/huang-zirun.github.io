<header>
  <script>
    (function () {
      try {
        var savedLang = localStorage.getItem("site_lang") || "en";
        document.documentElement.setAttribute("data-lang", savedLang);
      } catch (e) {
        document.documentElement.setAttribute("data-lang", "en");
      }
    })();
  </script>
  <style>
    /* Prevent horizontal layout shift across pages with different content heights */
    html {
      overflow-y: scroll;
      scrollbar-gutter: stable;
    }

    /* Bilingual visibility: strictly show only active language (default: en) */
    html:not([data-lang="zh"]) .lang-zh {
      display: none !important;
    }
    html[data-lang="zh"] .lang-en {
      display: none !important;
    }

    /* Enforce identical navbar geometry across all pages */
    @media (min-width: 576px) {
      #navbar {
        min-height: 58px !important;
      }
      #navbar > .container {
        max-width: {{ site.max_width | default: '800px' }} !important;
        display: flex !important;
        flex-wrap: nowrap !important;
        align-items: center !important;
        justify-content: space-between !important;
        min-height: 42px !important;
      }
      #navbar .navbar-brand.social {
        margin-bottom: 0 !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        flex-shrink: 0;
        display: inline-flex !important;
        align-items: center !important;
      }
      #navbar #navbarNav {
        display: flex !important;
        flex-basis: auto !important;
        flex-grow: 0 !important;
        align-items: center !important;
        margin-left: auto !important;
      }
      #navbar .navbar-nav.navbar-menu-list {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: nowrap !important;
        align-items: center !important;
        margin-left: auto !important;
        margin-bottom: 0 !important;
      }
      #navbar .navbar-nav > li.nav-item,
      #navbar .navbar-nav > li.toggle-container {
        display: inline-flex !important;
        align-items: center !important;
        height: 36px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
      }
      #navbar .navbar-nav > li.nav-item > a.nav-link {
        display: inline-flex !important;
        align-items: center !important;
        height: 36px !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        line-height: 1 !important;
      }
    }

    /* Unify theme toggle and zh/en language toggle vertical alignment & remove border */
    #navbar .navbar-nav .toggle-container {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      vertical-align: middle !important;
      padding: 0 !important;
    }
    #navbar #light-toggle {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      height: 36px !important;
      width: 28px !important;
      padding: 0 !important;
      margin: 0 0 0 0.25rem !important;
      border: none !important;
      outline: none !important;
      box-shadow: none !important;
      background: transparent !important;
      line-height: 1 !important;
      vertical-align: middle !important;
      transform: none !important;
    }
    #navbar #light-toggle i,
    #navbar #light-toggle #light-toggle-system,
    #navbar #light-toggle #light-toggle-dark,
    #navbar #light-toggle #light-toggle-light {
      padding: 0 !important;
      margin: 0 !important;
      line-height: 1 !important;
      vertical-align: middle !important;
      transform: none !important;
      top: 0 !important;
    }
    #navbar .navbar-nav .toggle-container.lang-toggle-container {
      margin-left: 0.2rem !important;
    }
    #navbar #lang-toggle {
      background: transparent !important;
      border: none !important;
      outline: none !important;
      box-shadow: none !important;
      padding: 0 0.25rem !important;
      margin: 0 !important;
      height: 36px !important;
      cursor: pointer;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      color: var(--global-text-color);
      font-family: "Book Antiqua", Palatino, "Palatino Linotype", Georgia, serif;
      font-size: 0.9rem !important;
      line-height: 1 !important;
      letter-spacing: 0.01em;
      transition: color 0.15s ease;
      white-space: nowrap;
      vertical-align: middle !important;
      transform: none !important;
    }
    #navbar #lang-toggle:focus,
    #navbar #lang-toggle:active {
      border: none !important;
      outline: none !important;
      box-shadow: none !important;
    }
    #navbar #lang-toggle .lang-opt {
      opacity: 0.42;
      font-weight: 400;
      transition: opacity 0.15s ease, color 0.15s ease;
    }
    #navbar #lang-toggle .lang-sep {
      opacity: 0.35;
      margin: 0 0.12rem;
      font-weight: 400;
    }
    html:not([data-lang="zh"]) #navbar #lang-toggle .lang-opt-en,
    html[data-lang="zh"] #navbar #lang-toggle .lang-opt-zh {
      opacity: 1;
      font-weight: 700;
    }
    #navbar #lang-toggle:hover,
    #navbar #lang-toggle:hover .lang-opt,
    #navbar #lang-toggle:hover .lang-sep {
      color: var(--global-theme-color);
    }

    /* Optional external internship logo outside left of badge */
    .publications ol.bibliography li .abbr {
      position: relative;
    }
    .publications ol.bibliography li .abbr img.abbr-external-logo {
      height: 1.35rem !important;
      width: 1.35rem !important;
      max-width: 1.35rem !important;
      max-height: 1.35rem !important;
      object-fit: contain;
      display: inline-block;
      vertical-align: middle;
      margin-right: 0.35rem;
    }
    @media (min-width: 576px) {
      .publications ol.bibliography li .abbr img.abbr-external-logo {
        position: absolute;
        left: -1.75rem;
        top: 0;
        margin-right: 0;
      }
    }

    /* Tech stack tags in individual small boxes */
    .publications ol.bibliography li .project-tech-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 0.38rem;
      margin: 0.3rem 0 0.38rem 0;
    }
    .publications ol.bibliography li .project-tech-stack .tech-tag {
      display: inline-block;
      font-family: "Book Antiqua", Palatino, "Palatino Linotype", Georgia, serif;
      font-size: 0.76rem;
      line-height: 1.25;
      padding: 0.12rem 0.48rem;
      border-radius: 3px;
      border: 1px solid var(--global-divider-color);
      background-color: rgba(128, 128, 128, 0.06);
      color: var(--global-text-color);
      white-space: nowrap;
    }

    /* Compact profile photo on About page to balance with left bio text */
    @media (min-width: 576px) {
      .post .profile {
        width: 21% !important;
        max-width: 162px !important;
        margin-left: 1.5rem !important;
        margin-bottom: 0.5rem !important;
      }
    }
    .post .profile figure,
    .post .profile picture {
      margin-bottom: 0.45rem !important;
    }
    .post .profile img {
      width: 100% !important;
      aspect-ratio: 3 / 4 !important;
      object-fit: cover !important;
      object-position: center 6% !important;
    }
    .post .profile .more-info {
      font-size: 0.85rem !important;
      line-height: 1.45 !important;
      margin-top: 0.35rem !important;
    }
    .post .profile .more-info p {
      margin-bottom: 0.15rem !important;
    }
  </style>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if site.enable_navbar_social %}
        <!-- Social Icons across all pages for consistent alignment -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% else %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              <span class="lang-en">{{- about_title }}</span>
              <span class="lang-zh">关于</span>
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.redirect and p.redirect != true -%}
                    {%- assign url = p.redirect -%}
                  {%- elsif p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a
                    class="nav-link"
                    href="{{ url | relative_url }}"
                    {% if p.redirect_en and p.redirect_zh %}
                      data-href-en="{{ p.redirect_en | relative_url }}"
                      data-href-zh="{{ p.redirect_zh | relative_url }}"
                    {% endif %}
                  >
                    <span class="lang-en">{{- p.title }}</span>
                    <span class="lang-zh">{{- p.title_zh | default: p.title }}</span>
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
          <!-- Language toggle (zh/en) -->
          <li class="toggle-container lang-toggle-container">
            <button id="lang-toggle" type="button" title="Switch language (zh/en)" aria-label="Switch language">
              <span class="lang-opt lang-opt-zh">zh</span><span class="lang-sep">/</span><span class="lang-opt lang-opt-en">en</span>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
  <script>
    function syncBilingualLinks(lang) {
      document.querySelectorAll("a[data-href-en][data-href-zh]").forEach(function (el) {
        el.setAttribute("href", lang === "zh" ? el.getAttribute("data-href-zh") : el.getAttribute("data-href-en"));
      });
      var bibInput = document.getElementById("bibsearch");
      if (bibInput) {
        bibInput.setAttribute("placeholder", lang === "zh" ? "输入关键词筛选论文..." : "Type to filter");
      }
    }

    document.addEventListener("DOMContentLoaded", function () {
      var initialLang = document.documentElement.getAttribute("data-lang") || "en";
      syncBilingualLinks(initialLang);

      // Only allow jumping on configured accounts (Email, WeChat QR, LinkedIn, GitHub); prevent navigation on others
      document.querySelectorAll(".navbar-brand.social a, .contact-icons a").forEach(function (a) {
        var href = (a.getAttribute("href") || "").trim();
        var isConfigured =
          href.indexOf("mailto:") === 0 ||
          href.indexOf("linkedin.com/in/huangyuchang") !== -1 ||
          href.indexOf("github.com/huang-zirun") !== -1 ||
          href.indexOf("wechat.jpg") !== -1;
        if (!isConfigured) {
          a.setAttribute("href", "javascript:void(0)");
          a.removeAttribute("target");
          a.removeAttribute("rel");
          a.style.cursor = "default";
          a.addEventListener("click", function (e) {
            e.preventDefault();
          });
        }
      });

      var btn = document.getElementById("lang-toggle");
      if (!btn) return;
      btn.addEventListener("click", function () {
        var current = document.documentElement.getAttribute("data-lang") || "en";
        var next = current === "zh" ? "en" : "zh";
        document.documentElement.setAttribute("data-lang", next);
        try {
          localStorage.setItem("site_lang", next);
        } catch (e) {}
        syncBilingualLinks(next);
        window.dispatchEvent(new Event("resize"));
      });
    });
  </script>
</header>
