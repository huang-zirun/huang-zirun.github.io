<header>
  <script>
    (function () {
      try {
        var savedLang = localStorage.getItem("site_lang") || "en";
        document.documentElement.setAttribute("data-lang", savedLang);
      } catch (e) {
        document.documentElement.setAttribute("data-lang", "en");
      }
    })();
  </script>
  <style>
    /* Bilingual visibility: strictly show only active language (default: en) */
    html:not([data-lang="zh"]) .lang-zh {
      display: none !important;
    }
    html[data-lang="zh"] .lang-en {
      display: none !important;
    }

    /* Language toggle button: aligned with dark/light toggle style */
    .navbar-nav .toggle-container.lang-toggle-container {
      display: flex;
      align-items: center;
      margin-left: 0.15rem;
    }
    #lang-toggle {
      background: transparent;
      border: none;
      padding: 0.25rem 0.35rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--global-text-color);
      font-family: "Book Antiqua", Palatino, "Palatino Linotype", Georgia, serif;
      font-size: 0.85rem;
      line-height: 1;
      letter-spacing: 0.01em;
      transition: color 0.15s ease;
    }
    #lang-toggle .lang-opt {
      opacity: 0.42;
      font-weight: 400;
      transition: opacity 0.15s ease, color 0.15s ease;
    }
    #lang-toggle .lang-sep {
      opacity: 0.35;
      margin: 0 0.12rem;
      font-weight: 400;
    }
    html:not([data-lang="zh"]) #lang-toggle .lang-opt-en,
    html[data-lang="zh"] #lang-toggle .lang-opt-zh {
      opacity: 1;
      font-weight: 700;
    }
    #lang-toggle:hover,
    #lang-toggle:hover .lang-opt,
    #lang-toggle:hover .lang-sep {
      color: var(--global-theme-color);
    }

    /* Optional external internship logo outside left of badge */
    .publications ol.bibliography li .abbr {
      position: relative;
    }
    .publications ol.bibliography li .abbr img.abbr-external-logo {
      height: 1.35rem !important;
      width: 1.35rem !important;
      max-width: 1.35rem !important;
      max-height: 1.35rem !important;
      object-fit: contain;
      display: inline-block;
      vertical-align: middle;
      margin-right: 0.35rem;
    }
    @media (min-width: 576px) {
      .publications ol.bibliography li .abbr img.abbr-external-logo {
        position: absolute;
        left: -1.75rem;
        top: 0;
        margin-right: 0;
      }
    }
  </style>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink == '/' or page.permalink == '/publications/' or page.permalink == '/projects/' %}
        {% if site.enable_navbar_social %}
          <!-- Social Icons -->
          <div class="navbar-brand social">{% social_links %}</div>
        {% endif %}
      {% else %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              <span class="lang-en">{{- about_title }}</span>
              <span class="lang-zh">关于</span>
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.redirect and p.redirect != true -%}
                    {%- assign url = p.redirect -%}
                  {%- elsif p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    <span class="lang-en">{{- p.title }}</span>
                    <span class="lang-zh">{{- p.title_zh | default: p.title }}</span>
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
          <!-- Language toggle (zh/en) -->
          <li class="toggle-container lang-toggle-container">
            <button id="lang-toggle" type="button" title="Switch language (zh/en)" aria-label="Switch language">
              <span class="lang-opt lang-opt-zh">zh</span><span class="lang-sep">/</span><span class="lang-opt lang-opt-en">en</span>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var btn = document.getElementById("lang-toggle");
      if (!btn) return;
      btn.addEventListener("click", function () {
        var current = document.documentElement.getAttribute("data-lang") || "en";
        var next = current === "zh" ? "en" : "zh";
        document.documentElement.setAttribute("data-lang", next);
        try {
          localStorage.setItem("site_lang", next);
        } catch (e) {}
        window.dispatchEvent(new Event("resize"));
      });
    });
  </script>
</header>
